# Backend API Endpoint
# Local: http://localhost:8080/api
# Railway: https://${{Backend.RAILWAY_PUBLIC_DOMAIN}}/api
VITE_API_BASE_URL="http://localhost:8080/api"
VITE_API_URL="http://localhost:8080/api"

# Cloudinary Pinyin Audio Assets
VITE_CLOUDINARY_PINYIN_AUDIO_BASE_URL="https://res.cloudinary.com/dtshwjjbc/video/upload/v1760853479/chinese-master/pinyin-audio"

# Logging & Port
VITE_SILENCE_LOGS=false
PORT=5501
