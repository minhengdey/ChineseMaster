{
   "order": 1,
   "title": "Bài 1 你好",
   "conversations": [
      {
         "section": "你好吗",
         "vn_translation": "Chào bạn!",
         "lines": [
            {
               "speaker": "大卫",
               "zh": "你好！",
               "pinyin": "Nǐ hǎo!",
               "vn": "Xin chào!"
            },
            {
               "speaker": "李军",
               "zh": "你好！",
               "pinyin": "Nǐ hǎo!",
               "vn": "Chào bạn!"
            },
            {
               "speaker": "大卫",
               "zh": "你是老师吗？",
               "pinyin": "Nǐ shì lǎoshī ma?",
               "vn": "Bạn là giáo viên phải không?"
            },
            {
               "speaker": "李军",
               "zh": "不是，我不是老师，我是学生。她是老师。",
               "pinyin": "Bú shì, wǒ bú shì lǎoshī, wǒ shì xuésheng. Tā shì lǎoshī.",
               "vn": "Không, tôi không phải giáo viên, tôi là học sinh. Cô ấy là giáo viên."
            },
            {
               "speaker": "大卫",
               "zh": "谢谢。",
               "pinyin": "Xièxie.",
               "vn": "Cảm ơn."
            },
            {
               "speaker": "李军",
               "zh": "不客气。",
               "pinyin": "Bú kèqi.",
               "vn": "Không có gì."
            }
         ]
      },
      {
         "section": "你叫什么名字？",
         "vn_translation": "Bạn tên là gì?",
         "lines": [
            {
               "speaker": "大卫",
               "zh": "老师，您好！",
               "pinyin": "Lǎoshī, nín hǎo!",
               "vn": "Thầy/cô giáo, xin chào!"
            },
            {
               "speaker": "王老师",
               "zh": "你好！你是留学生吗？",
               "pinyin": "Nǐ hǎo! Nǐ shì liúxuésheng ma?",
               "vn": "Chào bạn! Bạn là lưu học sinh phải không?"
            },
            {
               "speaker": "大卫",
               "zh": "是。我是留学生。",
               "pinyin": "Shì. Wǒ shì liúxuésheng.",
               "vn": "Vâng. Tôi là lưu học sinh."
            },
            {
               "speaker": "王老师",
               "zh": "你叫什么名字？",
               "pinyin": "Nǐ jiào shénme míngzi?",
               "vn": "Bạn tên là gì?"
            },
            {
               "speaker": "大卫",
               "zh": "我叫大卫。",
               "pinyin": "Wǒ jiào Dàwèi.",
               "vn": "Tôi tên là David."
            }
         ]
      }
   ],
