# ==============================================================================
# BUCHA BACKEND - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================

# 1. DATABASE CONFIGURATION (MySQL / Railway DB)
# Local: jdbc:mysql://localhost:3306/buchadb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
# Railway: jdbc:${{DB.MYSQL_URL}}
DB_URL="jdbc:mysql://localhost:3306/buchadb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8"
DB_USERNAME="bucha"
DB_PASSWORD="buchapass"

# 2. JWT SECURITY CONFIGURATION
JWT_SECRET="your_super_secret_jwt_key_at_least_256_bits_length"

# 3. CORS & COOKIE CONFIGURATION
ALLOW_ORIGINS="http://localhost:5501,http://localhost:5173"
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
COOKIE_SAME_SITE=Lax

# 4. DATA INITIALIZER & ADMIN ACCOUNT
DATA_INITIALIZER_ENABLED="false"
ADMIN_EMAIL=admin@chinesemaster.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Administrator

# 5. IFLYTEK AI (ISE & IAT)
APP_ID="your_iflytek_app_id"
API_KEY="your_iflytek_api_key"
API_SECRET="your_iflytek_api_secret"
IFLYTEK_IAT_HOST=iat-api-sg.xf-yun.com
IFLYTEK_IAT_PATH=/v2/iat

# 6. CLOUDINARY CONFIGURATION
CLOUD_NAME="your_cloudinary_cloud_name"
CLOUD_API_KEY="your_cloudinary_api_key"
CLOUD_API_SECRET="your_cloudinary_api_secret"

# 7. SPEECH EVALUATION SERVICE ENDPOINT
ISE_SCORE_URL="http://localhost:8080/api/ise/score"

# 8. DOUBAO AI (BYTEDANCE)
DOUBAO_API_URL=https://api.doubao-ai.com/v1/chat/completions
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-pro-32k
